{
  "name": "mandimitra",
  "version": "1.0.0",
  "description": "Smart Procurement Scheduling, Queue Management & Farmer Assistance Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm run test --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "mandimitra",
    "smart-india-hackathon",
    "agriculture",
    "queue-management",
    "procurement",
    "farmer-assistance"
  ],
  "author": "MandiMitra Team",
  "license": "MIT"
}
