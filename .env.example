# MandiMitra Environment Configuration

# Database
DATABASE_URL="postgresql://varunamarendrasingh@localhost:5432/mandimitra_db?schema=public"
DIRECT_URL="postgresql://varunamarendrasingh@localhost:5432/mandimitra_db?schema=public"

# Redis (optional, in-memory fallback included)
